<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VPNApp.UI.ServersPage"
             BackgroundColor="#0A0A0A"
             Title="">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BackgroundDark">#0A0A0A</Color>
            <Color x:Key="CardDark">#1E1E1E</Color>
            <Color x:Key="BorderDark">#2A2A2A</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#888888</Color>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#1E1E1E"/>
                <Setter Property="Stroke" Value="#2A2A2A"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ШАПКА -->
        <Grid Grid.Row="0"
              Padding="20,50,20,16"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="8"
              BackgroundColor="#0A0A0A">

            <Border Grid.Column="0"
                   BackgroundColor="#1E1E1E"
                   Stroke="#2A2A2A"
                   StrokeShape="RoundRectangle 10"
                   Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Border.GestureRecognizers>
                <Label Text="‹" TextColor="#FFFFFF" FontSize="22"/>
            </Border>

            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Серверы"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Label x:Name="ServerCountLabel"
                       Text="Загрузка..."
                       TextColor="#888888"
                       FontSize="11"/>
            </StackLayout>

            <!-- Кнопка сортировки -->
            <Border Grid.Column="2"
                   BackgroundColor="#1E1E1E"
                   Stroke="#2A2A2A"
                   StrokeShape="RoundRectangle 10"
                   Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSortClicked"/>
                </Border.GestureRecognizers>
                <Label Text="⇅" TextColor="#FFFFFF" FontSize="18"/>
            </Border>

            <!-- Кнопка проверки пинга -->
            <Border Grid.Column="3"
                   BackgroundColor="#1E1E1E"
                   Stroke="#2A2A2A"
                   StrokeShape="RoundRectangle 10"
                   Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPingAllClicked"/>
                </Border.GestureRecognizers>
                <Label Text="📡" FontSize="18"/>
            </Border>

        </Grid>

        <!-- ПОИСК -->
        <Border Grid.Row="1"
               BackgroundColor="#1E1E1E"
               Stroke="#2A2A2A"
               StrokeShape="RoundRectangle 12"
               Padding="14,10"
               Margin="20,0,20,14">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="🔍"
                       FontSize="16"
                       VerticalOptions="Center"
                       Margin="0,0,10,0"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Поиск серверов..."
                       PlaceholderColor="#555555"
                       TextColor="#FFFFFF"
                       BackgroundColor="Transparent"
                       FontSize="14"
                       TextChanged="OnSearchTextChanged"/>
            </Grid>
        </Border>

        <!-- СПИСОК СЕРВЕРОВ -->
        <CollectionView Grid.Row="2"
                        x:Name="ServersCollection"
                        Margin="20,0,20,20"
                        SelectionMode="Single"
                        IsGrouped="True"
                        SelectionChanged="OnServerSelected">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <StackLayout Padding="0,16,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding Name}"
                                   TextColor="#888888"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding ServerCount, StringFormat='{0} шт.'}"
                                   TextColor="#444444"
                                   FontSize="11"/>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#2A2A2A"
                                 Margin="0,6,0,0"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E"
                            Stroke="#2A2A2A"
                            StrokeShape="RoundRectangle 16"
                            Padding="18"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                   BackgroundColor="#2A2A2A"
                                   Stroke="Transparent"
                                   StrokeShape="RoundRectangle 8"
                                   Padding="8"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0">
                                <Label Text="{Binding FlagEmoji}"
                                       FontSize="22"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CleanName}"
                                   TextColor="#FFFFFF"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="End"/>

                            <StackLayout Grid.Row="1" Grid.Column="1"
                                         Orientation="Horizontal" Spacing="8">
                                <Border BackgroundColor="#2A2A2A"
                                       Stroke="Transparent"
                                       StrokeShape="RoundRectangle 5"
                                       Padding="6,2">
                                    <Label Text="{Binding ProtocolDisplay}"
                                           TextColor="#888888"
                                           FontSize="10"
                                           FontAttributes="Bold"/>
                                </Border>
                                <Label Text="{Binding Address}"
                                       TextColor="#555555"
                                       FontSize="11"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"/>
                            </StackLayout>

                            <Label Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                   Text="{Binding PingDisplay}"
                                   TextColor="{Binding PingColor}"
                                   FontSize="12"
                                   FontFamily="Monospace"
                                   VerticalOptions="Center"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             Padding="40">
                    <Label Text="🌐"
                           FontSize="48"
                           HorizontalOptions="Center"/>
                    <Label Text="Нет серверов"
                           TextColor="#FFFFFF"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Добавьте подписку на главном экране чтобы получить список серверов"
                           TextColor="#555555"
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>