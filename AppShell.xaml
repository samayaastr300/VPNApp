<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:ui="clr-namespace:VPNApp.UI"
       x:Class="VPNApp.AppShell"
       BackgroundColor="#0A0A0A"
       FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>

            <!-- Скрываем стандартный Navigation Bar — у нас свой -->
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="#0A0A0A"/>
                <Setter Property="BarTextColor"       Value="#FFFFFF"/>
            </Style>

        </ResourceDictionary>
    </Shell.Resources>

    <!-- Главная страница -->
    <ShellContent
        Title="Главная"
        ContentTemplate="{DataTemplate ui:MainPage}"
        Route="MainPage"/>

</Shell>
